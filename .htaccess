RewriteEngine On
RewriteBase /

# --- ЗАКРЫВАЕМ СЛУЖЕБНЫЕ КАТАЛОГИ ОТ ПРЯМОГО ДОСТУПА ---
# Внутренние include() через файловую систему это не затрагивает.
# Без правила /components/404.php и /templates/location_template.php
# открывались по HTTP с кодом 200 и могли попасть в индекс.
RewriteRule ^(components|templates)/ - [F,L]

# --- РОКИРОВКА (должна быть ПЕРВОЙ) ---
# Манипулятор: ВСЕ старые адреса -> /evakuator-manipulator-kharkov (реальная БД-страница)
RewriteRule ^ua/uslugi-manipulyatora-kharkov/?$ /ua/evakuator-manipulator-kharkov [R=301,L]
RewriteRule ^uslugi-manipulyatora-kharkov/?$ /evakuator-manipulator-kharkov [R=301,L]

RewriteRule ^ua/Arenda-Krana-Manipulyatora(\.php|\.html)?$ /ua/evakuator-manipulator-kharkov [R=301,L]
RewriteRule ^Arenda-Krana-Manipulyatora(\.php|\.html)?$ /evakuator-manipulator-kharkov [R=301,L]

RewriteRule ^ua/manipulator-kharkov/?$ /ua/evakuator-manipulator-kharkov [R=301,L]
RewriteRule ^manipulator-kharkov/?$ /evakuator-manipulator-kharkov [R=301,L]

RewriteRule ^ua/vykup-bityh-avtomobilej-v-harkove(\.php|\.html)?$ /ua/avtovykup-kharkov [R=301,L]
RewriteRule ^vykup-bityh-avtomobilej-v-harkove(\.php|\.html)?$ /avtovykup-kharkov [R=301,L]

RewriteRule ^ua/Evakuatsiya-spetstekhniki-v-Kharkove(\.php|\.html)?$ /ua/Perevozka-spetstekhniki-Kharkov [R=301,L]
RewriteRule ^Evakuatsiya-spetstekhniki-v-Kharkove(\.php|\.html)?$ /Perevozka-spetstekhniki-Kharkov [R=301,L]

# Блог: news -> blog
RewriteRule ^ua/news/?$ /ua/blog [R=301,L]
RewriteRule ^news/?$ /blog [R=301,L]

# evakuator-services (дубль главной) -> главная
RewriteRule ^ua/evakuator-services/?$ /ua/ [R=301,L]
RewriteRule ^evakuator-services/?$ / [R=301,L]

# --- БЛОК 1: Убираем index и index.php ---
RewriteCond %{THE_REQUEST} /index(\.php)? [NC]
RewriteRule ^(.*)index(\.php)?$ /$1 [R=301,L]


# --- БЛОК 3: SEO И БЕЗОПАСНОСТЬ ---

# 1. Склейка зеркал: удаляем WWW
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# 2. Принудительный HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# 3. Убираем слэш в конце адреса
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# 4. Удаление .html
RewriteCond %{THE_REQUEST} " /([^ ]+)\.html"
RewriteRule ^ /%1 [L,R=301]

# 5. Удаление .php
RewriteCond %{THE_REQUEST} " /([^ ]+)\.php"
RewriteRule ^ /%1 [L,R=301]


# Динамическая карта блога: /sitemap-blog.xml -> sitemap-blog.php
RewriteRule ^sitemap-blog\.xml$ /sitemap-blog.php [L]


# --- БЛОК 4: ПОДКЛЮЧЕНИЕ ФАЙЛОВ (Физических) ---

# 6. Сначала ищем реальный PHP файл
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# 7. Если PHP нет, ищем реальный HTML файл
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]


# --- БЛОК 4.5: CMS РОУТИНГ (Если файлы НЕ найдены) ---

# Если файла нет — отправляем в роутер
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Правило для UA (запросы вида /ua/slug)
# Мы передаем slug без префикса ua/ прямо в router.php
RewriteRule ^ua/([^/]+)$ router.php?slug=$1&lang=ua [L,QSA]

# Правило для RU (запросы в корне)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)$ router.php?slug=$1&lang=ru [L,QSA]

# ВСЁ ОСТАЛЬНОЕ (вложенные пути, битые ссылки, отсутствующие ассеты)
# тоже уходит в роутер — он отдаст 404 с нормальной страницей.
# Без этого правила Apache показывал свою дефолтную страницу,
# и components/404.php никто не видел.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ router.php [L,QSA]


# --- БЛОК 5: ЗАЩИТА И ПРИВАТНОСТЬ ---

# 1. Запрещаем прямой доступ к базе и конфигам (внутренние include не затрагиваются)
<FilesMatch "^(data\.json|my_site_database\.db|db_connect\.php|config\.php|db\.php|Medoo\.php)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# 2. Запрещаем индексацию админки
<FilesMatch "^(admin\.php|sitemap_gen\.php)$">
    Header set X-Robots-Tag "noindex, nofollow"
</FilesMatch>


# --- БЛОК 6: КЭШИРОВАНИЕ СТАТИКИ ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp     "access plus 1 year"
    ExpiresByType image/jpeg     "access plus 1 year"
    ExpiresByType image/png      "access plus 1 year"
    ExpiresByType image/gif      "access plus 1 year"
    ExpiresByType image/svg+xml  "access plus 1 year"
    ExpiresByType image/x-icon   "access plus 1 year"
    ExpiresByType font/woff2     "access plus 1 year"
    ExpiresByType text/css       "access plus 14 days"
    ExpiresByType application/javascript "access plus 14 days"
</IfModule>

# gzip/brotli-сжатие текстовых ресурсов
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json
</IfModule>

